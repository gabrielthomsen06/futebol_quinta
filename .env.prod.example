# ==========================================================
# SÓ NO MIGUÉ FC — produção
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# O .env.prod real NUNCA vai para o Git. Ele vive só na VPS.
#
# Com APP_ENV=production a aplicação RECUSA INICIAR se SECRET_KEY,
# DATABASE_URL ou CORS_ORIGINS estiverem ausentes ou com valor de exemplo.
# Isso é proposital: um site fora do ar chama atenção; um site no ar com a
# chave de exemplo do repositório, não.
# ==========================================================

# ---------- Domínio ----------
# AINDA NÃO DEFINIDO. Duas formas de preencher:
#
#   1. Antes de ter domínio, para validar a stack inteira por HTTP:
#        DOMINIO=:80
#
#   2. Com o domínio real, DEPOIS que o registro A já apontar para o IP da
#      VPS e tiver propagado. O Caddy emite o certificado no primeiro acesso;
#      subir antes da propagação faz o Let's Encrypt falhar, e tentativas
#      repetidas batem no limite semanal.
#        DOMINIO=seudominio.com.br
DOMINIO=

# ---------- Banco ----------
POSTGRES_USER=migue
# Gere: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=migue

# Precisa repetir a senha acima. O host é o nome do serviço na rede interna.
DATABASE_URL=postgresql+psycopg://migue:COLE_A_MESMA_SENHA_AQUI@db:5432/migue

# ---------- Segurança ----------
# Gere: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo de 32 caracteres. Trocá-la invalida todas as sessões abertas —
# é também o botão de emergência se um token vazar.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=720

ADMIN_USERNAME=admin
# Só o comando create-admin lê esta variável. Mínimo de 12 caracteres.
# DEPOIS de criar o administrador, você pode apagar esta linha: o hash já
# está no banco e nada mais a lê.
ADMIN_PASSWORD=

# Origem pública do site, exatamente como o navegador a envia.
# Nunca "*". Com DOMINIO=:80 para teste local, use http://localhost
CORS_ORIGINS=

# ---------- Geral ----------
TZ=America/Sao_Paulo
CURRENT_SEASON=2026
LOG_LEVEL=INFO

# ---------- Backup (Cloudflare R2 via rclone) ----------
# Nome do remote configurado com `rclone config`. O bucket é criado no
# painel do R2. As credenciais ficam no ~/.config/rclone/rclone.conf da
# VPS, não aqui.
RCLONE_REMOTE=r2
RCLONE_BUCKET=migue-backups
# Onde os arquivos ficam na VPS antes de serem enviados.
BACKUP_DIR=/var/backups/migue
# Quantos dias de backup diário manter localmente.
BACKUP_RETENCAO_DIAS=30
