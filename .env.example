# ==========================================================
# SÓ NO MIGUÉ FC — variáveis de ambiente
# Copie para .env e troque os valores. O .env NÃO vai para o Git.
#   cp .env.example .env
# ==========================================================

# ---------- Banco de dados ----------
POSTGRES_USER=migue
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=migue
POSTGRES_PORT=5432

# Usada pelo backend dentro da rede do Docker (host = nome do serviço "db").
# Rodando o backend fora do Docker, troque "db" por "localhost".
DATABASE_URL=postgresql+psycopg://migue:troque-esta-senha@db:5432/migue

# ---------- Segurança ----------
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gere-uma-chave-aleatoria-e-longa
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Credenciais do único administrador (usadas pelo comando create-admin, na Fase 4).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# ---------- API ----------
# Origens permitidas no CORS, separadas por vírgula. Nunca use "*" em produção.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Fotos dos jogadores ----------
MEDIA_ROOT=/app/media
MEDIA_URL_PREFIX=/media

# ---------- Geral ----------
TZ=America/Sao_Paulo
CURRENT_SEASON=2026

# ---------- Frontend ----------
# Caminho relativo: o Vite faz proxy de /api para o backend.
VITE_API_URL=/api
# Alvo do proxy do Vite. Dentro do Docker é o nome do serviço; fora, localhost.
VITE_PROXY_TARGET=http://backend:8000
