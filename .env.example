# ==========================================================
# SÓ NO MIGUÉ FC — variáveis de ambiente
# Copie para .env e troque os valores. O .env NÃO vai para o Git.
#   cp .env.example .env
# ==========================================================

# ---------- Banco de dados ----------
POSTGRES_USER=migue
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=migue
POSTGRES_PORT=5432

# Usada pelo backend dentro da rede do Docker (host = nome do serviço "db").
# Rodando o backend fora do Docker, troque "db" por "localhost".
DATABASE_URL=postgresql+psycopg://migue:troque-esta-senha@db:5432/migue

# ---------- Segurança ----------
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gere-uma-chave-aleatoria-e-longa
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Credenciais do único administrador (usadas pelo comando create-admin, na Fase 4).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# ---------- API ----------
# Origens permitidas no CORS, separadas por vírgula. Nunca use "*" em produção.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Fotos dos jogadores ----------
# "local" grava em disco (o volume do Docker). Em desenvolvimento é o que
# você quer: nada de credencial de nuvem para rodar o projeto.
# No Heroku vale "r2" — lá o disco do dyno some a cada deploy.
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL_PREFIX=/media

# Só com STORAGE_BACKEND=r2. Em desenvolvimento ficam vazias.
# R2_ENDPOINT_URL=https://<id-da-conta>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=migue-fotos
# Domínio público do bucket, se houver. Vazio faz a aplicação assinar uma
# URL temporária a cada acesso, o que funciona com o bucket fechado.
# R2_PUBLIC_BASE_URL=

# ---------- Geral ----------
TZ=America/Sao_Paulo
CURRENT_SEASON=2026

# ---------- Frontend ----------
# Caminho relativo: o Vite faz proxy de /api para o backend.
VITE_API_URL=/api
# Alvo do proxy do Vite. Dentro do Docker é o nome do serviço; fora, localhost.
VITE_PROXY_TARGET=http://backend:8000
